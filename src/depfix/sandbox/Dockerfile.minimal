# pytest only: small and quick to build on a slow connection. Enough for projects whose tests
# need nothing but the standard library and pytest. (`depfix sandbox build --minimal`)
FROM python:3.12-slim
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=100 \
    PIP_RETRIES=10 \
    PIP_NO_CACHE_DIR=1 \
    PIP_PREFER_BINARY=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN pip install "pytest>=8,<9"
WORKDIR /work
